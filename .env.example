# ---------------------------------------------------------------------------
# Status page (statuspage service) configuration.
# Copy to .env and adjust. All values are optional except admin credentials,
# which you should change before exposing the admin panel.
# ---------------------------------------------------------------------------

# Address of the xray-checker instance (internal).
CHECKER_URL=http://xray-checker:2112

# How often to poll the checker, in seconds. Keep equal to PROXY_CHECK_INTERVAL.
POLL_INTERVAL=60

# How many days of uptime history to display.
DAYS=30

# How many days of per-minute samples to retain (defaults to DAYS + 1).
# SAMPLE_RETAIN_DAYS=31

# Timezone for day boundaries and date labels.
TZ=Europe/Moscow

# Where the LMDB database and uploaded brand images live.
DATA_DIR=/data

# HTTP port.
PORT=8080

# Value of the `Server` response header (fingerprint masking).
SERVER_HEADER=nginx

# Initial branding — only used to seed the config on first start. After that,
# manage title/subtitle/logo/theme from the /admin panel.
TITLE=Статус серверов
SUBTITLE=Доступность серверов в реальном времени

# ---- Admin panel ----------------------------------------------------------
# Credentials for the /admin panel. CHANGE THESE.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Secret used to sign the admin session cookie. If empty, a stable secret is
# derived from the admin credentials (sessions survive restarts). Set your own
# long random value in production.
# SESSION_SECRET=
